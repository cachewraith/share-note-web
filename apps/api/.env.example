# Copy to .env and adjust. Every variable is validated at boot; the process
# refuses to start if one is missing or malformed.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Public URLs. PUBLIC_WEB_URL is what share links point at; PUBLIC_API_URL is
# where attachments are served from. Both must be reachable by the browser.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

DATABASE_URL=postgresql://share_note:share_note@localhost:5432/share_note?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=share-note
S3_ACCESS_KEY_ID=share_note
S3_SECRET_ACCESS_KEY=share_note_dev_secret
S3_FORCE_PATH_STYLE=true

# OpenAPI UI at /docs. Must be false when NODE_ENV=production.
ENABLE_DOCS=true
# Run `prisma migrate deploy` during bootstrap (used by the container image).
RUN_MIGRATIONS_ON_START=false
# Only enable behind a reverse proxy you control: it makes the API believe
# X-Forwarded-For, which rate limiting keys on.
TRUST_PROXY=false

# Browser origins allowed to call the API directly. The viewer is server
# rendered, so this is usually empty.
CORS_ALLOWED_ORIGINS=

MARKDOWN_MAX_BYTES=1048576
ASSET_MAX_BYTES=10485760
ASSETS_PER_SHARE_MAX=50

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READ_MAX=300
RATE_LIMIT_WRITE_MAX=30
# Shared by every reader: the viewer calls the API from one address.
RATE_LIMIT_PUBLIC_MAX=600
