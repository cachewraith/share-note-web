# Copy to .env.local and adjust.

# Where the web app reaches the API from the server side (container network).
API_INTERNAL_URL=http://localhost:3001
# Where a browser reaches the API. Used to build image and OpenGraph URLs.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Canonical origin of the viewer itself, for OpenGraph and canonical links.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Seconds a rendered note stays cached before revalidation.
SHARE_REVALIDATE_SECONDS=60
