# Copy to .env.local and adjust. All of these are read at runtime by the
# server, so one Docker image works for any host.

# Where the server reaches the API. Inside docker compose this is a service
# name, e.g. http://api:3001.
API_INTERNAL_URL=http://localhost:3001

# Where a browser reaches the API. Attachment URLs point here, and the
# Content-Security-Policy names it as the only external image source.
PUBLIC_API_URL=http://localhost:3001

# This app's own public origin, used for canonical and OpenGraph URLs.
PUBLIC_WEB_URL=http://localhost:3000

# How long a fetched note may be served before the API is asked again.
SHARE_REVALIDATE_SECONDS=60
