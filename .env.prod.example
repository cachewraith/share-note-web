# Copy to .env next to docker-compose.yml and fill in. Keep it out of git:
# it holds the database password and the object-storage credentials.

# Public origins, as a browser sees them. Both must be https in production.
PUBLIC_WEB_URL=https://notes.example.com
PUBLIC_API_URL=https://notes-api.example.com

POSTGRES_USER=share_note
POSTGRES_PASSWORD=change-me
POSTGRES_DB=share_note

# Object storage. With the bundled MinIO these are also its root credentials.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=share-note
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# For Cloudflare R2, drop the minio and minio-init services and use:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
# Keep the bucket private: attachments are served through the API, which is
# what applies the right Content-Type and nosniff. A public r2.dev URL
# bypasses both.

# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
# 0 means unsharing takes effect immediately, at one small API call per page
# view. Raise it only if you would rather serve a deleted note for a while.
SHARE_CACHE_SECONDS=0
